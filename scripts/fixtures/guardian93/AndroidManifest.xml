<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.whatsapp">
    <uses-sdk android:minSdkVersion="37" android:targetSdkVersion="37" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <application android:label="Synthetic Guardian sender" android:allowBackup="false">
        <activity android:name="android.app.Activity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".SendFixture" android:exported="true" android:permission="android.permission.DUMP" />
    </application>
</manifest>
